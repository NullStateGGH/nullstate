[Unit]
Description=NullState MCP Protocol Server
After=network.target
Wants=nullstate.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/Nullstate-linux-vm/src/network/mcp_server.py
User=amjad
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/Nullstate-linux-vm/src

[Install]
WantedBy=multi-user.target
